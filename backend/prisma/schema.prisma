// Worker OS — database schema
// Conventions: UUID ids, UTC timestamps, companyId on every tenant-owned row,
// append-only WorkEvent / AuditLog, soft delete (deletedAt) on user-managed catalog entities.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  COMPANY_ADMIN
  MANAGER
  FOREMAN
  WORKER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum CompanyVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum SiteStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

enum ShiftStatus {
  OPEN // started, not ended
  CLOSED // ended, awaiting supervisor verification
  NEEDS_REVIEW // missed checkout / anomaly — requires correction
  VERIFIED // supervisor confirmed → counts in identity
  REJECTED // supervisor rejected (reason required)
}

enum WorkEventType {
  WORK_STARTED
  WORK_ENDED
  SHIFT_AUTO_CLOSED
  SHIFT_VERIFIED
  SHIFT_REJECTED
  SHIFT_CORRECTED
  TASK_ASSIGNED
  TASK_STARTED
  TASK_SUBMITTED
  TASK_APPROVED
  TASK_REJECTED
  TASK_CHANGES_REQUESTED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
}

enum EventSource {
  MOBILE_APP
  FOREMAN_APP
  KIOSK
  SYSTEM
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum EvidenceKind {
  PHOTO
  DOCUMENT
}

enum VacancyStatus {
  DRAFT
  OPEN
  PAUSED
  CLOSED
  FILLED
}

enum PaymentPeriod {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  PER_TASK
}

enum ApplicationStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum DisputeStatus {
  OPEN
  ACCEPTED
  REJECTED
}

enum WorkerAvailability {
  AVAILABLE
  EMPLOYED
  NOT_LOOKING
}

// ───────────────────────────── Identity & auth ─────────────────────────────

model User {
  id                String    @id @default(uuid()) @db.Uuid
  phone             String    @unique // E.164, e.g. +998901234567
  fullName          String?   @db.VarChar(120)
  locale            String    @default("uz") @db.VarChar(8)
  isActive          Boolean   @default(true)
  isPlatformAdmin   Boolean   @default(false)
  notificationPrefs Json      @default("{}")
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships        CompanyMembership[] @relation("MembershipUser")
  invitedMemberships CompanyMembership[] @relation("MembershipInvitedBy")
  workerProfile      WorkerProfile?
  sessions           Session[]
  deviceTokens       DeviceToken[]
  notifications      Notification[]
  siteAssignments    SiteAssignment[]    @relation("AssignmentUser")
  shifts             Shift[]             @relation("ShiftWorker")
  applications       Application[]       @relation("ApplicationWorker")
  assignedTasks      Task[]              @relation("TaskAssignee")
  createdCompanies   Company[]           @relation("CompanyCreatedBy")
}

model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?   @db.VarChar(64)
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

/// One row per device login. Access tokens carry the session id, so revoking the session
/// (logout, reuse detection, deactivation) invalidates every token of that device immediately.
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  deviceId      String?   @db.VarChar(128)
  deviceName    String?   @db.VarChar(120)
  platform      String?   @db.VarChar(20)
  ip            String?   @db.VarChar(64)
  userAgent     String?   @db.VarChar(255)
  expiresAt     DateTime
  lastUsedAt    DateTime  @default(now())
  revokedAt     DateTime?
  revokedReason String?   @db.VarChar(40)
  createdAt     DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
}

/// Rotating refresh tokens. Presenting an already-rotated token = theft signal → session revoked.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @db.Uuid
  tokenHash String    @unique
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  String   @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Tenancy ─────────────────────────────

model Company {
  id                   String                    @id @default(uuid()) @db.Uuid
  name                 String                    @db.VarChar(160)
  industry             String                    @default("CONSTRUCTION") @db.VarChar(40)
  description          String?                   @db.VarChar(2000)
  phone                String?                   @db.VarChar(20)
  region               String?                   @db.VarChar(80)
  city                 String?                   @db.VarChar(80)
  address              String?                   @db.VarChar(255)
  timezone             String                    @default("Asia/Tashkent") @db.VarChar(40)
  registrationNumber   String?                   @db.VarChar(20) // company STIR (tax id) — only for verification
  verificationStatus   CompanyVerificationStatus @default(UNVERIFIED)
  verificationNote     String?                   @db.VarChar(500)
  verifiedAt           DateTime?
  createdById          String                    @db.Uuid
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  deletedAt            DateTime?

  createdBy    User                @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  memberships  CompanyMembership[]
  projects     Project[]
  sites        Site[]
  shifts       Shift[]
  workEvents   WorkEvent[]
  tasks        Task[]
  vacancies    Vacancy[]
  applications Application[]
  blocks       CompanyWorkerBlock[]
  disputes     Dispute[]
  evidence     Evidence[]
}

model CompanyMembership {
  id          String           @id @default(uuid()) @db.Uuid
  companyId   String           @db.Uuid
  userId      String           @db.Uuid
  role        Role
  status      MembershipStatus @default(ACTIVE)
  title       String?          @db.VarChar(80) // trade / position inside the company, e.g. "G'isht teruvchi"
  invitedById String?          @db.Uuid
  joinedAt    DateTime         @default(now())
  removedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  user      User    @relation("MembershipUser", fields: [userId], references: [id])
  invitedBy User?   @relation("MembershipInvitedBy", fields: [invitedById], references: [id])

  @@unique([companyId, userId])
  @@index([userId, status])
  @@index([companyId, role, status])
}

model CompanyWorkerBlock {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  userId      String   @db.Uuid
  reason      String   @db.VarChar(500)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, userId])
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  name        String        @db.VarChar(160)
  description String?       @db.VarChar(2000)
  address     String?       @db.VarChar(255)
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  createdById String        @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id])
  sites   Site[]

  @@index([companyId, deletedAt])
}

model Site {
  id               String     @id @default(uuid()) @db.Uuid
  companyId        String     @db.Uuid
  projectId        String     @db.Uuid
  name             String     @db.VarChar(160)
  address          String?    @db.VarChar(255)
  latitude         Float
  longitude        Float
  radiusMeters     Int        @default(200)
  timezone         String     @default("Asia/Tashkent") @db.VarChar(40)
  shiftStart       String     @default("08:00") @db.VarChar(5) // HH:mm site-local
  shiftEnd         String     @default("18:00") @db.VarChar(5)
  lateGraceMinutes Int        @default(15)
  workDays         Int[]      @default([1, 2, 3, 4, 5, 6]) // ISO weekday 1=Mon..7=Sun
  status           SiteStatus @default(ACTIVE)
  createdById      String     @db.Uuid
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  company     Company          @relation(fields: [companyId], references: [id])
  project     Project          @relation(fields: [projectId], references: [id])
  assignments SiteAssignment[]
  shifts      Shift[]
  workEvents  WorkEvent[]
  tasks       Task[]
  vacancies   Vacancy[]

  @@index([companyId, deletedAt])
  @@index([projectId])
}

/// Employment on a concrete site (worker or foreman). A user can be assigned to many sites.
model SiteAssignment {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @db.Uuid
  siteId       String           @db.Uuid
  userId       String           @db.Uuid
  role         Role // WORKER or FOREMAN (MANAGER possible later)
  isResident   Boolean          @default(false) // lives on site → GPS presence is not work evidence
  status       AssignmentStatus @default(ACTIVE)
  startDate    DateTime         @default(now())
  endDate      DateTime?
  assignedById String           @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  site Site @relation(fields: [siteId], references: [id])
  user User @relation("AssignmentUser", fields: [userId], references: [id])

  @@index([siteId, status])
  @@index([userId, status])
  @@index([companyId, status])
  // partial unique index "one ACTIVE assignment per (site,user)" is added in SQL migration
}

// ───────────────────────────── Worker identity ─────────────────────────────

model WorkerProfile {
  id                          String             @id @default(uuid()) @db.Uuid
  userId                      String             @unique @db.Uuid
  primaryTrade                String?            @db.VarChar(80)
  trades                      String[]           @default([])
  selfReportedExperienceYears Int?
  bio                         String?            @db.VarChar(1000)
  region                      String?            @db.VarChar(80)
  city                        String?            @db.VarChar(80)
  availability                WorkerAvailability @default(AVAILABLE)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Work ─────────────────────────────

/// Projection over WorkEvents. Never the source of truth for history — events are.
model Shift {
  id              String      @id @default(uuid()) @db.Uuid
  companyId       String      @db.Uuid
  siteId          String      @db.Uuid
  workerId        String      @db.Uuid
  businessDate    DateTime    @db.Date // site-local date of the start
  startedAt       DateTime // effective (possibly corrected) start
  endedAt         DateTime? // effective (possibly corrected) end
  originalStartAt DateTime // as recorded by the start event
  originalEndAt   DateTime?
  status          ShiftStatus @default(OPEN)
  isResident      Boolean     @default(false)
  isLate          Boolean     @default(false)
  lateMinutes     Int         @default(0)
  workedMinutes   Int         @default(0) // effective end - start (0 when not ended)
  breakMinutes    Int         @default(0)
  verifiedMinutes Int         @default(0) // counts in identity only when VERIFIED
  flags           String[]    @default([])
  verifiedById    String?     @db.Uuid
  verifiedAt      DateTime?
  reviewNote      String?     @db.VarChar(500)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company  Company     @relation(fields: [companyId], references: [id])
  site     Site        @relation(fields: [siteId], references: [id])
  worker   User        @relation("ShiftWorker", fields: [workerId], references: [id])
  events   WorkEvent[]
  disputes Dispute[]
  evidence Evidence[]

  @@index([companyId, businessDate])
  @@index([siteId, businessDate])
  @@index([workerId, businessDate])
  @@index([companyId, status])
  // partial unique index "one OPEN shift per worker" is added in SQL migration
}

/// Append-only event log — the heart of the domain.
model WorkEvent {
  id             String        @id @default(uuid()) @db.Uuid
  clientEventId  String?       @db.VarChar(64) // idempotency key generated on device
  companyId      String        @db.Uuid
  siteId         String?       @db.Uuid
  shiftId        String?       @db.Uuid
  subjectUserId  String        @db.Uuid // the worker the event is about
  actorUserId    String        @db.Uuid // who performed it (worker, foreman, system)
  type           WorkEventType
  source         EventSource
  occurredAt     DateTime // when it happened (device clock / declared)
  receivedAt     DateTime      @default(now()) // when the server received it
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  isMocked       Boolean?
  distanceMeters Float?
  insideGeofence Boolean?
  deviceId       String?       @db.VarChar(128)
  entityType     String?       @db.VarChar(40)
  entityId       String?       @db.Uuid
  reason         String?       @db.VarChar(500)
  flags          String[]      @default([])
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())

  company Company @relation(fields: [companyId], references: [id])
  site    Site?   @relation(fields: [siteId], references: [id])
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  @@unique([actorUserId, clientEventId])
  @@index([subjectUserId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([shiftId])
  @@index([deviceId, occurredAt])
}

model Task {
  id                String     @id @default(uuid()) @db.Uuid
  companyId         String     @db.Uuid
  siteId            String     @db.Uuid
  assigneeId        String     @db.Uuid
  createdById       String     @db.Uuid
  title             String     @db.VarChar(160)
  description       String?    @db.VarChar(2000)
  quantity          Decimal?   @db.Decimal(12, 2)
  unit              String?    @db.VarChar(16)
  completedQuantity Decimal?   @db.Decimal(12, 2)
  dueDate           DateTime?  @db.Date
  status            TaskStatus @default(ASSIGNED)
  submissionNote    String?    @db.VarChar(1000)
  startedAt         DateTime?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewedById      String?    @db.Uuid
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  company   Company        @relation(fields: [companyId], references: [id])
  site      Site           @relation(fields: [siteId], references: [id])
  assignee  User           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  approvals TaskApproval[]
  evidence  Evidence[]

  @@index([companyId, status])
  @@index([siteId, status])
  @@index([assigneeId, status])
}

model TaskApproval {
  id         String           @id @default(uuid()) @db.Uuid
  taskId     String           @db.Uuid
  reviewerId String           @db.Uuid
  decision   ApprovalDecision
  comment    String?          @db.VarChar(1000)
  createdAt  DateTime         @default(now())

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
}

model Evidence {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @db.Uuid
  taskId       String?      @db.Uuid
  shiftId      String?      @db.Uuid
  uploadedById String       @db.Uuid
  kind         EvidenceKind
  storageKey   String       @unique
  mimeType     String       @db.VarChar(80)
  sizeBytes    Int
  sha256       String       @db.VarChar(64)
  originalName String?      @db.VarChar(120) // sanitised
  comment      String?      @db.VarChar(1000)
  capturedAt   DateTime?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?

  company Company @relation(fields: [companyId], references: [id])
  task    Task?   @relation(fields: [taskId], references: [id])
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  @@index([taskId])
  @@index([shiftId])
}

model Dispute {
  id           String        @id @default(uuid()) @db.Uuid
  companyId    String        @db.Uuid
  shiftId      String        @db.Uuid
  openedById   String        @db.Uuid
  reason       String        @db.VarChar(1000)
  claimedStart DateTime?
  claimedEnd   DateTime?
  status       DisputeStatus @default(OPEN)
  resolution   String?       @db.VarChar(1000)
  resolvedById String?       @db.Uuid
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  shift   Shift   @relation(fields: [shiftId], references: [id])

  @@index([companyId, status])
  @@index([shiftId])
}

// ───────────────────────────── Marketplace ─────────────────────────────

model Vacancy {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @db.Uuid
  siteId        String?       @db.Uuid
  createdById   String        @db.Uuid
  title         String        @db.VarChar(160)
  description   String        @db.VarChar(4000)
  category      String        @db.VarChar(80)
  region        String?       @db.VarChar(80)
  city          String?       @db.VarChar(80)
  address       String?       @db.VarChar(255)
  latitude      Float?
  longitude     Float?
  rateAmount    Decimal       @db.Decimal(14, 2)
  currency      String        @default("UZS") @db.VarChar(3)
  paymentPeriod PaymentPeriod
  workersNeeded Int           @default(1)
  startDate     DateTime?     @db.Date
  durationDays  Int?
  requirements  String?       @db.VarChar(2000)
  status        VacancyStatus @default(DRAFT)
  publishedAt   DateTime?
  closedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  company      Company       @relation(fields: [companyId], references: [id])
  site         Site?         @relation(fields: [siteId], references: [id])
  applications Application[]

  @@index([status, publishedAt])
  @@index([companyId, status])
  @@index([category, status])
}

model Application {
  id              String            @id @default(uuid()) @db.Uuid
  vacancyId       String            @db.Uuid
  companyId       String            @db.Uuid
  workerId        String            @db.Uuid
  coverNote       String?           @db.VarChar(1000)
  status          ApplicationStatus @default(SUBMITTED)
  statusReason    String?           @db.VarChar(500)
  statusChangedAt DateTime          @default(now())
  statusChangedBy String?           @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  vacancy Vacancy @relation(fields: [vacancyId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  worker  User    @relation("ApplicationWorker", fields: [workerId], references: [id])

  @@unique([vacancyId, workerId])
  @@index([companyId, status])
  @@index([workerId, status])
}

// ───────────────────────────── Cross-cutting ─────────────────────────────

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  companyId String?   @db.Uuid
  type      String    @db.VarChar(40)
  category  String    @db.VarChar(20)
  title     String    @db.VarChar(160)
  body      String    @db.VarChar(500)
  data      Json      @default("{}")
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(60)
  entityType  String   @db.VarChar(40)
  entityId    String?  @db.VarChar(64)
  metadata    Json     @default("{}")
  ip          String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}
