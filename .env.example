# ───── Worker OS environment (copy to .env and fill in; never commit .env) ─────
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=worker
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=worker_os
POSTGRES_PORT=5432

# API
PORT=3000
# Comma-separated allow-list of browser origins (mobile apps do not need CORS)
CORS_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API (1 behind nginx)
TRUST_PROXY=0
SWAGGER_ENABLED=true
LOG_LEVEL=info

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# HMAC pepper for OTP hashes — generate with: openssl rand -base64 32
OTP_PEPPER=

# OTP / SMS
# SMS_PROVIDER=eskiz | dev
#   dev   → no SMS is sent; OTP_DEV_CODE is accepted for every phone (NEVER in production)
#   eskiz → Eskiz.uz SMS gateway (requires ESKIZ_* credentials)
SMS_PROVIDER=dev
OTP_DEV_CODE=
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Object storage (S3-compatible; SeaweedFS in dev). Files are served only through the API
# (auth-checked) or via short-lived presigned URLs.
S3_ENDPOINT=http://localhost:8333
S3_PORT=8333
S3_REGION=us-east-1
S3_BUCKET=worker-evidence
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=8388608
# s3 | database — `database` keeps evidence bytes in PostgreSQL (serverless hosts without S3, e.g. Vercel)
STORAGE_DRIVER=s3

# Secret for GET /api/v1/internal/jobs/attendance (Vercel Cron / external scheduler). Empty → endpoint disabled.
CRON_SECRET=

# Firebase Cloud Messaging (optional — push is disabled when empty; in-app notifications still work)
# Base64 of the service-account JSON
FCM_SERVICE_ACCOUNT_BASE64=

# Background jobs (reminders / late & absent alerts)
JOBS_ENABLED=true

# Nginx
HTTP_PORT=80
HTTPS_PORT=443
